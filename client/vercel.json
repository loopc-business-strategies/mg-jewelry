{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_URL": "https://mg-jewelry-api-production.up.railway.app/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mg-jewelry-api-production.up.railway.app/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
