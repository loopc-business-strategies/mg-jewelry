# Shared
NODE_ENV=development

# PostgreSQL (local: use Railway public DATABASE_URL after deploy, or docker-compose)
DATABASE_URL=postgresql://mg:mg_secret@localhost:5432/mg_jewelry?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set to 1 to show Demo Admin / Demo Customer buttons on /auth
NEXT_PUBLIC_SHOW_DEMO_LOGIN=1

# Payments (ALLOW_MOCK_PAYMENTS defaults on in development, off in production)
ALLOW_MOCK_PAYMENTS=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Email (optional — Resend)
RESEND_API_KEY=
EMAIL_FROM=MG Jewelry <onboarding@resend.dev>

# Media / CMS (Cloudinary preferred; otherwise local disk under UPLOAD_DIR)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Showroom
SHOWROOM_CITY=Namangan City
SHOWROOM_COUNTRY=Republic of Uzbekistan
SHOWROOM_ADDRESS=242, Girvonbulok Street, Davlatabad District, Namangan City, Namangan Region, Republic of Uzbekistan

# Alerts (optional — skip Telegram until bot is created)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
